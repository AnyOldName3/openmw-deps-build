{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "boost-geometry",
    "boost-iostreams",
    "boost-program-options",
    {
      "name": "bullet3",
      "features": [
        "double-precision",
        "multithreading"
      ]
    },
    "ffmpeg",
    "freetype",
    "icu",
    "luajit",
    "lz4",
    {
      "name": "mygui",
      "platform": "!osx"
    },
    "openal-soft",
    {
      "name": "openmw-mygui-osx",
      "platform": "osx"
    },
    "openmw-osg",
    {
      "name": "sdl2",
      "platform": "!linux"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "platform": "linux",
      "features": [
        "dbus",
        "x11",
        "wayland"
      ]
    },
    {
      "name": "unshield",
      "platform": "osx|linux"
    }
  ],
  "builtin-baseline": "6d332a018c433fad20822ff4b536e4ccdc3413bd",
  "overrides": [
    {
      "name": "icu",
      "version": "74.2#6",
      "$why": "The next version in vcpkg requires newer autoconf than AlmaLinux 9 provides"
    },
    {
      "name": "gperf",
      "version": "3.1#7",
      "$why": "The next version in vcpkg requires newer autoconf than AlmaLinux 9 provides"
    }
  ]
}
